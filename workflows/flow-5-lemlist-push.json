    {
      "parameters": {
        "jsCode": "const body = $input.first().json?.body || $input.first().json || {};\nconst mode = (body.mode || 'preview').toLowerCase();\nconst tier = (body.tier || 'all').toLowerCase();\nconst email = body.email || '';\nconst requested = Number(body.batch_size || 100);\nconst batch_size = mode === 'single' ? 1 : Math.min(requested, 100);\n\n// One Lemlist campaign per persona group: sales leaders (tiers 1 to 3) and founders (tier 4 fallback).\n// An empty ID disables that group: node 5 skips contacts that have no target campaign.\nconst CAMPAIGN_SALES_LEADERS = 'YOUR_LEMLIST_CAMPAIGN_ID_SALES_LEADERS';\nconst CAMPAIGN_FOUNDERS = 'YOUR_LEMLIST_CAMPAIGN_ID_FOUNDERS';\n\nreturn [{ json: {\n  mode, tier, email, batch_size,\n  run_id: 'flow5-' + Date.now(),\n  campaign_direction_sales: CAMPAIGN_SALES_LEADERS,\n  campaign_ceo_fallback: CAMPAIGN_FOUNDERS,\n  is_dry_run: mode === 'preview'\n} }];"
      },
      "id": "6d788803-a235-5133-ad18-025fbd9541d7",
      "name": "2. Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        304
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_SLACK_CHANNEL_ID_MONITORING"
        },
        "text": "={{ '🚀 *Flow 5 — Outreach Lemlist push* — START\\n*Run:* ' + $json.run_id + '\\n*Mode:* ' + $json.mode + ' | *Tier filter:* ' + $json.tier + ' | *Batch size:* ' + $json.batch_size + ($json.is_dry_run ? ' 🔍 DRY-RUN (preview only)' : '') }}",
        "otherOptions": {}
      },
      "id": "80a1c4cb-c549-5819-9140-d5ac809e1b95",
      "name": "3. Slack START",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        608,
