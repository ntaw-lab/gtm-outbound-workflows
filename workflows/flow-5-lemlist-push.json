        "text": "={{ (() => {\n  const items = $json.items || [];\n  if (items.length === 0) return '🛑 *Flow 5 PREVIEW* — Aucun contact trouvé selon critères.';\n  const lines = items.map(i => '   • ' + (i.firstName||'?') + ' ' + (i.lastName||'?') + ' — *' + (i.jobTitle||'?').slice(0,40) + '* @ ' + (i.companyName||'?') + ' → ' + i.target_campaign_label + ' (T:' + i.persona_tier + ')').join('\\n');\n  return '🔍 *Flow 5 PREVIEW (DRY-RUN)* — ' + items.length + ' contacts qui SERAIENT pushés:\\n' + lines + '\\n\\n_Pour vraiment push: re-trigger avec mode=batch + même tier_';\n})() }}",
