        "text": "={{ (() => {\n  const items = $json.items || [];\n  if (items.length === 0) return '🛑 *Flow 5 DONE* — 0 contacts pushés.';\n  const lines = items.map(i => '   ✅ ' + (i.firstName||'?') + ' ' + (i.lastName||'?') + ' (' + (i.companyName||'?') + ') → ' + i.target_campaign_label).join('\\n');\n  return '🚀 *Flow 5 DONE — ' + items.length + ' contacts pushés vers Lemlist*\\n' + lines + '\\n\\n_HS Contact outbound_status mis à jour à \\'sent\\' pour chaque._';\n})() }}",
