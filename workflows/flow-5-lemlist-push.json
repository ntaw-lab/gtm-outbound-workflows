      ],
      "webhookId": "f08eea42-5d6b-5f11-9a9a-89d068c9b371",
      "credentials": {
        "slackApi": {
          "id": null,
          "name": "Slack bot"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filterGroups: [{   filters: $('2. Normalize Input').first().json.mode === 'single'     ? [{propertyName:'email',operator:'EQ',value:$('2. Normalize Input').first().json.email},        {propertyName:'persona_status',operator:'EQ',value:'qualified'}]     : [{propertyName:'persona_status',operator:'EQ',value:'qualified'},        {propertyName:'outbound_status',operator:'EQ',value:'not_started'}] }], sorts: [{propertyName:'createdate',direction:'ASCENDING'}], limit: $('2. Normalize Input').first().json.mode === 'single' ? 1 : Math.max(10, Number($('2. Normalize Input').first().json.batch_size) || 10), properties: ['email','firstname','lastname','jobtitle','job_title_lemlist','company','tam_linkedin_url','persona_tier','persona_status','outbound_status','score_persona']}) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "73f9e7dd-6f32-5c8c-9769-a7249f3969ce",
      "name": "4. HS Search qualified+notStarted",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        304
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": null,
          "name": "HubSpot private app (Bearer)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const params = $('2. Normalize Input').first().json;\nconst search = $input.first().json;\nconst all = search.results || [];\n\nconst SALES_TIERS = new Set(['1_cro_vp_sales', '2_director_of_sales', '3_revops_lead']);\nconst CEO_TIERS = new Set(['4_ceo_fallback']);\n\nconst out = [];\nfor (const c of all) {\n  const p = c.properties || {};\n  const tier_key = p.persona_tier || '';\n  const isSales = SALES_TIERS.has(tier_key);\n  const isCeo = CEO_TIERS.has(tier_key);\n\n  // Apply tier filter\n  if (params.tier === 'sales' && !isSales) continue;\n  if (params.tier === 'ceo' && !isCeo) continue;\n  // 'all' = accept both\n\n  // Skip if no email or no LinkedIn URL (Lemlist needs email for the lead key)\n  if (!p.email) continue;\n  if (!p.tam_linkedin_url) continue;\n\n  const target_campaign = isSales ? params.campaign_direction_sales :\n                          isCeo ? params.campaign_ceo_fallback : null;\n  if (!target_campaign) continue;\n\n  out.push({\n    json: {\n      hs_id: c.id,\n      email: p.email,\n      firstName: p.firstname || '',\n      lastName: p.lastname || '',\n      companyName: p.company || '',\n      jobTitle: p.job_title_lemlist || p.jobtitle || '',\n      linkedinUrl: p.tam_linkedin_url || '',\n      persona_tier: tier_key,\n      score_persona: p.score_persona || 0,\n      target_campaign,\n      target_campaign_label: isSales ? 'Direction Sales' : 'CEO Fallback',\n      mode: params.mode,\n      is_dry_run: params.is_dry_run,\n      run_id: params.run_id,\n    }\n  });\n}\n// Enforce batch_size cap (HS API floor is 10, so we trim post-filter)\nconst maxOut = Number(params.batch_size) || 10;\nreturn out.slice(0, maxOut);"
      },
      "id": "84e41123-2828-5d12-8a93-f3895bb09b96",
      "name": "5. Filter by tier + prepare items",
      "type": "n8n-nodes-base.code",
