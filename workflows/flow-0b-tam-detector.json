{
  "name": "Flow 0b — Phantombuster TAM detector",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 * * * *"
            }
          ]
        }
      },
      "id": "31ccec84-43af-53a2-881e-19b3f6e73a88",
      "name": "Schedule hourly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/companies/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filterGroups: [{ filters: [{ propertyName: 'tam_status', operator: 'NOT_HAS_PROPERTY' }, { propertyName: 'domain', operator: 'HAS_PROPERTY' }] }], properties: ['name','domain','website','linkedin_company_page','industry','founded_year','city','country','description','numberofemployees','hs_object_source'], sorts: [{ propertyName: 'createdate', direction: 'DESCENDING' }], limit: 100 }) }}"
      },
      "id": "2ac2e708-c906-5494-85eb-b9b64b838be0",
      "name": "1. HS Search untagged companies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": null,
          "name": "HubSpot private app (Bearer)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Prepare batch update — fill TAM properties on companies that Phantombuster (or any integration) just imported\nconst today = new Date().toISOString().slice(0, 10);\nconst results = $input.first().json.results || [];\n\nconst inputs = [];\nfor (const c of results) {\n  const p = c.properties || {};\n  const dom = String(p.domain || '').toLowerCase().trim();\n  if (!dom) continue;  // Skip without domain\n\n  inputs.push({\n    id: c.id,\n    properties: {\n      tam_status: 'new',\n      tam_domain: dom,\n      tam_first_seen: today,\n      tam_industry: p.industry || '',\n    }\n  });\n}\n\nif (inputs.length === 0) {\n  return [{ json: { skip: true, count: 0, message: 'No untagged companies detected' } }];\n}\n\nreturn [{ json: { skip: false, count: inputs.length, inputs, sample: results.slice(0, 5).map(c => c.properties.name) } }];"
      },
      "id": "e623a01f-9c9f-5789-944c-066b1ecac4f7",
      "name": "2. Prepare TAM payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "83ab3f37-fe51-57ea-a372-e335a1575324",
      "name": "3. IF any to update?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/companies/batch/update",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ inputs: $json.inputs }) }}"
      },
      "id": "214753db-9ab1-5cf4-b9e8-3952e1b7c382",
      "name": "4. PATCH HS Companies batch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": null,
          "name": "HubSpot private app (Bearer)"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_SLACK_CHANNEL_ID_BRIEFS"
        },
        "text": "=📥 *TAM detector* — {{ $('2. Prepare TAM payload').first().json.count }} entreprise(s) nouvellement importée(s) tagué(es) `tam_status=new`\\nÉchantillon : {{ $('2. Prepare TAM payload').first().json.sample.join(', ') }}\\nFlow 4 (planifié chaque matin) les scorera.",
        "otherOptions": {}
      },
      "id": "00f7ec05-44ad-59e7-98ba-11a35a34b68b",
      "name": "5. Slack notify",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        1300,
        200
      ],
      "webhookId": "80fd6263-a91f-5fec-9328-c91357120fca",
      "credentials": {
        "slackApi": {
          "id": null,
          "name": "Slack bot"
        }
      }
    }
  ],
  "connections": {
    "Schedule hourly": {
      "main": [
        [
          {
            "node": "1. HS Search untagged companies",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "1. HS Search untagged companies": {
      "main": [
        [
          {
            "node": "2. Prepare TAM payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "2. Prepare TAM payload": {
      "main": [
        [
          {
            "node": "3. IF any to update?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "3. IF any to update?": {
      "main": [
        [
          {
            "node": "4. PATCH HS Companies batch",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "4. PATCH HS Companies batch": {
      "main": [
        [
          {
            "node": "5. Slack notify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
